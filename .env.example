# App
APP_ENV="development"

# Hosting
HOST="localhost"
PORT=":8800"
BASE_URL="http://localhost:8800"

# Admin
ADMIN_SECRET_KEY="change-me-to-a-secret-key"

# Steam
STEAM_API_KEY=""

# JWT
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRY="24h"

# Database — use "db" when running via docker-compose, "localhost" otherwise
DB_HOST="db"
DB_PORT="5432"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="steamshark"
DB_SSLMODE="disable"
